      m_Calls: []
  m_text: "Alessandro\r\n3D room modelling\r\nCo-puzzle designer\r\nCo-game direction\r\n
    \r\nEric\r\nProject Manager\r\nCo-puzzle designer\r\nCo-game direction\n\nMatilda
    \r\nCo-3D Texture Designer\r\nCo-concept designer\r\n \r\nMelker\r\nCo-lead programmer\n\r\nRasmus
    \r\nLead programmer\r\nLead Github torture victim\r\nLead unity torture victim\r\nThe
    goat (I wanna die... its 2 in the morning as im writing this...-Rasmus )\r\n
    \r\nMax \r\n3D object/prop modelling\r\n \r\nMorris \r\nLead 3D texture designer\n\nAlfred
    \r\nCo-lead sound designer\r\nLead score composer\r\nTindra \r\nLead 2D graphical
    designer\r\nLead game marketing\r\nLead concept designer\r\n \r\nLiam \r\nAssistant
    programmer\r\nCo-puzzle designer\r\n \r\nJesper\r\nCo-lead programmer\r\n \r\nAlexander
    \r\nCo-lead programmer\n\nSebastian \r\nCo-lead sound designer\n\nJesper\r\n3D
    modelling & designing\n\nWilliam \r\n3D modelling & designing\r\n3D animator\n\nAnisa\r\nCo-2D
    graphical designer\r\nCo-concept designer\n\nKristoffer \r\nWind sound effect\n\n"
